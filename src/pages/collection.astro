---
import Layout from '../components/Layout.astro';
import SystemCard from '../components/SystemCard.astro';
import { systems, regions, converters } from '../data/systems';
---

<Layout title="Collection — Ancient Numbers" active="collection">
  <div class="container">
    <section class="collection-hero">
      <h1>Collection</h1>
      <p>{systems.length} numeral and counting traditions, grouped by region and structure.</p>
    </section>
    <div class="collection-tools">
      <div class="search-wrap">
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="8" cy="8" r="5.5" />
          <path d="M12 12L18 18" />
        </svg>
        <label for="collection-search" class="sr-only">
          Search traditions
        </label>
        <input
          id="collection-search"
          type="search"
          placeholder="Search by name or place…"
          autocomplete="off"
        />
      </div>
      <label for="region-filter" class="sr-only">
        Filter by region
      </label>
      <select id="region-filter">
        <option value="all">All regions</option>
        {regions.map((r) => (
          <option value={r}>{r}</option>
        ))}
      </select>
      <label for="structure-filter" class="sr-only">
        Filter by structure
      </label>
      <select id="structure-filter">
        <option value="all">All structures</option>
        {[
          'Positional',
          'Additive',
          'Multiplicative',
          'Alphabetic',
          'Spoken',
          'Physical',
          'Mixed',
        ].map((s) => (
          <option value={s}>{s}</option>
        ))}
      </select>
      <span id="filter-count" class="filter-count" role="status" aria-live="polite">
        {systems.length} traditions
      </span>
    </div>
    <p class="collection-key">
      {converters.length} converters
      {systems.length > converters.length
        ? ` · ${systems.length - converters.length} entries with selected examples.`
        : ' · Each entry shows its supported range.'}
    </p>
    <div class="collection-grid" id="collection-grid">
      {[...systems]
        .sort((a, b) => a.name.localeCompare(b.name))
        .map((s) => (
          <SystemCard system={s} />
        ))}
      <p id="no-results" class="no-results" hidden>
        No traditions match those filters.
      </p>
    </div>
  </div>
</Layout>
<script>
  const search = document.getElementById('collection-search') as HTMLInputElement;
  const region = document.getElementById('region-filter') as HTMLSelectElement;
  const structure = document.getElementById('structure-filter') as HTMLSelectElement;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const normalize = (s: string) =>
    s
      .normalize('NFD')
      .replace(/\p{Diacritic}/gu, '')
      .toLowerCase();
  function filter() {
    let count = 0;
    const query = normalize(search.value.trim());
    cards.forEach((c) => {
      const show =
        (!query || normalize(c.dataset.search ?? '').includes(query)) &&
        (region.value === 'all' || c.dataset.region === region.value) &&
        (structure.value === 'all' || c.dataset.structure === structure.value);
      c.hidden = !show;
      if (show) count++;
    });
    document.getElementById('filter-count')!.textContent =
      `${count} tradition${count === 1 ? '' : 's'}`;
    document.getElementById('no-results')!.hidden = count > 0;
  }
  search.addEventListener('input', filter);
  region.addEventListener('change', filter);
  structure.addEventListener('change', filter);
</script>
