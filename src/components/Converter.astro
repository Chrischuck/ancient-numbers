---
import { systems, regions, regionLabel, getSystem } from '../data/systems';
import Specimen from './Specimen.astro';
import { represent } from '../lib/format';
import { loadGlyphs } from '../lib/glyphs';
import { renderLearningGuide } from '../lib/learning-guide';
const initial = getSystem('babylonian')!;
const base = import.meta.env.BASE_URL;
---

<section id="converter" class="converter-section" aria-label="Numeral converter">
  <div class="converter-top">
    <div class="tabs" role="tablist" aria-label="Choose a tool">
      <button
        id="translate-tab"
        role="tab"
        aria-selected="true"
        aria-controls="input-panel"
        data-mode="translate"
      >
        Translate
      </button>
      <button
        id="calculate-tab"
        role="tab"
        aria-selected="false"
        aria-controls="input-panel"
        data-mode="calculate"
        tabindex="-1"
      >
        Calculate
      </button>
    </div>
    <a class="bases-guide-link" href={`${base}bases/`}>
      Understanding bases <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="converter-grid">
    <div id="input-panel" class="input-panel" role="tabpanel" aria-labelledby="translate-tab">
      <div class="input-heading">
        <label class="eyebrow" for="number-input">
          NUMBER
        </label>
        <span class="input-kind">Hindu-Arabic · base 10</span>
      </div>
      <input
        id="number-input"
        class="number-input"
        type="text"
        inputmode="decimal"
        value="42"
        maxlength="205"
        spellcheck="false"
        autocomplete="off"
        aria-describedby="input-help input-error"
      />
      <div id="arithmetic-fields" class="arithmetic-fields" hidden>
        <label class="sr-only" for="operation">
          Operation
        </label>
        <select id="operation">
          <option value="add">+ Add</option>
          <option value="subtract">− Subtract</option>
          <option value="multiply">× Multiply</option>
          <option value="divide">÷ Divide</option>
        </select>
        <label class="sr-only" for="second-input">
          Second number
        </label>
        <input
          id="second-input"
          type="text"
          inputmode="decimal"
          value="8"
          maxlength="205"
          autocomplete="off"
          spellcheck="false"
        />
      </div>
      <p id="input-help" class="input-help">
        Whole numbers, decimals, or fractions (e.g. 3/2).
      </p>
      <p id="input-error" class="input-error" role="alert" hidden></p>
      <div class="system-field">
        <label id="system-label" class="eyebrow" for="system-select">
          NUMERAL SYSTEM
        </label>
        <div class="select-wrap">
          <select id="system-select">
            {regions.map((region) => (
              <optgroup label={regionLabel(region)}>
                {systems
                  .filter((s) => s.region === region)
                  .sort((a, b) => a.name.localeCompare(b.name))
                  .map((s) => (
                    <option value={s.id} selected={s.id === initial.id}>
                      {s.name}
                      {s.engine === 'explainer' ? ' · examples only' : ''}
                    </option>
                  ))}
              </optgroup>
            ))}
          </select>
          <button
            id="system-picker-button"
            class="system-picker-button"
            type="button"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="system-picker"
            aria-labelledby="system-label system-picker-value"
            hidden
          >
            <span id="system-picker-value">{initial.name}</span>
            <svg viewBox="0 0 12 8" width="12" height="8" aria-hidden="true">
              <path d="m1 1 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </button>
          <dialog
            id="system-picker"
            class="system-picker"
            aria-label="Choose a numeral system"
            hidden
          >
            <div class="system-picker-header">
              <h2>Choose a numeral system</h2>
              <button id="system-picker-close" class="system-picker-close" type="button">
                Cancel
              </button>
            </div>
            <label class="sr-only" for="system-search">
              Search numeral systems
            </label>
            <input
              id="system-search"
              class="system-search"
              type="text"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="system-options"
              placeholder="Search systems or groups…"
              autocomplete="off"
              spellcheck="false"
            />
            <div
              id="system-options"
              class="system-options"
              role="listbox"
              aria-label="Numeral systems"
            ></div>
            <p id="system-search-status" class="system-search-status" role="status"></p>
          </dialog>
        </div>
      </div>
      <div id="example-chips" class="example-chips" aria-label="Try an example">
        {initial.examples.map((e) => (
          <button type="button" data-example={e.value}>
            {e.value}
          </button>
        ))}
      </div>
      <div class="input-note">
        <span class="live-dot" aria-hidden="true"></span>
        <span id="availability">Whole numbers</span>
      </div>
    </div>
    <div class="output-panel" aria-busy="false">
      <div class="output-heading">
        <span id="output-name" class="eyebrow">
          {initial.name.toLocaleUpperCase()}
        </span>
        <span id="output-base" class="base-badge">
          {initial.baseLabel}
        </span>
      </div>
      <div
        id="output-value"
        class="output-value"
        role="region"
        aria-label="Numeral result"
        tabindex="0"
      >
        <Specimen system={initial} value={42} />
      </div>
      <div id="output-message" class="output-message" hidden></div>
      <div class="result-caption">
        <span id="exact-value">42</span>
        <span class="result-separator" aria-hidden="true">
          /
        </span>
        <span id="output-equation">
          {represent({ numerator: 42n, denominator: 1n }, initial).explanation}
        </span>
      </div>
      <div class="output-actions">
        <button id="copy-button" type="button">
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M7 7H16V17H7ZM4 13H2V2H12V4" />
          </svg>
          Copy numeral
        </button>
        <button id="download-button" type="button">
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M10 2V12M6 8L10 12L14 8M3 13V17H17V13" />
          </svg>
          Save SVG
        </button>
        <button id="share-button" type="button">
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M7 10L13 5M7 11L13 15" />
            <circle cx="5" cy="10" r="2.5" />
            <circle cx="15" cy="4" r="2.5" />
            <circle cx="15" cy="16" r="2.5" />
          </svg>
          Share
        </button>
      </div>
      <span id="action-status" class="action-status" role="status"></span>
    </div>
  </div>
  <section
    id="conversion-guide"
    class="conversion-guide"
    aria-labelledby="conversion-guide-title"
    hidden
  >
    <h2 id="conversion-guide-title">How to read this number</h2>
    <div id="math-reasoning"></div>
    <details id="translated-equation" class="translated-equation" hidden></details>
  </section>
  <details id="notation-reference" class="notation-reference" open>
    <summary>Symbol dictionary and reading rules</summary>
    <section id="learning-guide" class="learning-guide" aria-labelledby="symbol-key-title">
      <Fragment set:html={renderLearningGuide(initial, await loadGlyphs(initial.region))} />
    </section>
  </details>
  <div class="converter-context">
    <div>
      <span class="eyebrow">NOTATION</span>
      <p id="system-summary">{initial.summary}</p>
    </div>
    <div class="context-location">
      <span class="eyebrow">PLACE &amp; TIME</span>
      <p id="system-location">
        {initial.location}
        <br />
        {initial.period}
      </p>
    </div>
    <a id="learn-link" href={`${base}systems/${initial.id}/`}>
      Details <span aria-hidden="true">↗</span>
    </a>
  </div>
  <details class="notation-details">
    <summary>
      How to read it <span aria-hidden="true">+</span>
    </summary>
    <div>
      <p id="reading-explanation">{initial.howItWorks}</p>
      <ol id="reading-steps" class="reading-steps">
        {initial.readingSteps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
      <p id="system-caveat">{initial.caveat}</p>
      <a id="system-source" href={initial.sources[0].url} target="_blank" rel="noopener noreferrer">
        Source ↗
      </a>
    </div>
  </details>
  <div class="compare-bar">
    <button id="add-comparison" class="text-button" type="button">
      Add comparison <span aria-hidden="true">+</span>
    </button>
  </div>
  <div id="comparisons" class="comparisons"></div>
  <div
    class="sr-only"
    id="result-announcement"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  ></div>
</section>
<script>
  import '../lib/converter-client';
</script>
