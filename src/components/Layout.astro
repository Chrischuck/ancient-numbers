---
import '@fontsource/newsreader/latin-400.css';
import '@fontsource/newsreader/latin-400-italic.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  active?: string;
}
const {
  title = 'Ancient Numbers — Number converter',
  description = 'Convert and compare numbers in 26 numeral systems, with sourced examples from 10 more counting traditions.',
  active = '',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const previewImage = new URL(`${base}social-card-v1.png`, Astro.site);
const previewAlt = 'Kaktovik, Maya, and Cistercian numerals on a dark green background.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ed" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ancient Numbers" />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={previewAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />
    <meta name="twitter:image:alt" content={previewAlt} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <header class="site-header container">
      <a class="brand" href={base} title="Ancient Numbers home">
        <svg viewBox="0 0 38 38" aria-hidden="true">
          <path d="M19 4V34M5 10L19 4L33 10M5 28L19 34L33 28M5 10V28M33 10V28M5 19H33" />
        </svg>
        <span>Ancient Numbers</span>
      </a>
      <nav aria-label="Main navigation">
        <a href={`${base}#converter`} aria-current={active === 'converter' ? 'page' : undefined}>
          Converter
        </a>
        <a href={`${base}collection/`} aria-current={active === 'collection' ? 'page' : undefined}>
          Collection
        </a>
        <a href={`${base}timeline/`} aria-current={active === 'timeline' ? 'page' : undefined}>
          Timeline
        </a>
        <a href={`${base}about/`} aria-current={active === 'about' ? 'page' : undefined}>
          About
        </a>
      </nav>
      <a
        class="source-link"
        href="https://github.com/CumputerSluts/ancient-numbers"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="View source on GitHub (opens in a new tab)"
        title="View source on GitHub"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .297C5.37.297 0 5.67 0 12.297c0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.838 1.237 1.838 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.3-5.467-1.334-5.467-5.93 0-1.31.467-2.38 1.235-3.22-.135-.303-.54-1.524.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 3-.404c1.02.005 2.045.138 3 .404 2.28-1.552 3.285-1.23 3.285-1.23.645 1.652.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
        </svg>
      </a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer container">
      <div>
        <a class="footer-brand" href={base}>
          Ancient Numbers
        </a>
      </div>
      <div>
        <a href={`${base}about/#sources`}>Sources ↗</a>
        <a href="https://github.com/CumputerSluts/ancient-numbers">GitHub ↗</a>
      </div>
    </footer>
  </body>
</html>
