---
import '@fontsource/newsreader/latin-400.css';
import '@fontsource/newsreader/latin-400-italic.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  active?: string;
}
const {
  title = 'Ancient Numbers — Number converter',
  description = 'Convert and compare numbers in 26 numeral systems, with sourced examples from 10 more counting traditions.',
  active = '',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const previewImage = new URL(`${base}social-card-v1.png`, Astro.site);
const previewAlt = 'Kaktovik, Maya, and Cistercian numerals on a dark green background.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ed" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ancient Numbers" />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={previewAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />
    <meta name="twitter:image:alt" content={previewAlt} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <header class="site-header container">
      <a class="brand" href={base} title="Ancient Numbers home">
        <svg viewBox="0 0 38 38" aria-hidden="true">
          <path d="M19 4V34M5 10L19 4L33 10M5 28L19 34L33 28M5 10V28M33 10V28M5 19H33" />
        </svg>
        <span>Ancient Numbers</span>
      </a>
      <nav aria-label="Main navigation">
        <a href={`${base}#converter`} aria-current={active === 'converter' ? 'page' : undefined}>
          Converter
        </a>
        <a href={`${base}collection/`} aria-current={active === 'collection' ? 'page' : undefined}>
          Collection
        </a>
        <a href={`${base}about/`} aria-current={active === 'about' ? 'page' : undefined}>
          About
        </a>
      </nav>
      <a
        class="source-link"
        href="https://github.com/CumputerSluts/ancient-numbers"
        target="_blank"
        rel="noopener noreferrer"
      >
        Open source <span aria-hidden="true">↗</span>
      </a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer container">
      <div>
        <a class="footer-brand" href={base}>
          Ancient Numbers
        </a>
      </div>
      <div>
        <a href={`${base}about/#sources`}>Sources ↗</a>
        <a href="https://github.com/CumputerSluts/ancient-numbers">GitHub ↗</a>
      </div>
    </footer>
  </body>
</html>
